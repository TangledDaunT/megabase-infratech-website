{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": { "maxDuration": 30, "includeFiles": "dist/**" }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Robots-Tag": "noindex, nofollow",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self' https:; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'self'"
      },
      "continue": true
    },
    { "src": "/(?:routes\\.json|_headers)", "dest": "/404.html", "status": 404 },
    { "src": "/terms\\.html", "status": 301, "headers": { "Location": "/terms-and-conditions/" } },
    { "src": "/projects/sector-110-noida/?", "status": 301, "headers": { "Location": "/projects/bhumi-residency/" } },
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index" }
  ]
}
