# Public site metadata. Indexing remains disabled unless all three values are set.
SITE_URL=https://your-approved-domain.example
INDEX_SITE=0
CONTENT_APPROVED=0

# Local HTTP server
PORT=4180

# Lead storage. Leave disabled for ordinary local development.
ENABLE_LEAD_STORAGE=0
# DATABASE_URL=

# Optional legacy Sheets fallback. Do not commit real values.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_TAB=
# SHEETS_WEBHOOK_URL=
# SHEETS_WEBHOOK_SECRET=

# Private admin dashboard. Configure only in the deployment environment.
# ADMIN_DATABASE_URL=
# ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_SECRET=
